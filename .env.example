APP_PORT=5000

# Required. Generate a long random value in the deployment platform; never commit it.
APP_SECRET=

# Generate once and retain across APP_SECRET rotations to keep opaque profile URLs stable.
PUBLIC_PROFILE_KEY_SECRET=

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003

DB_PASSWORD=
DB_URI=
API_KEY=
